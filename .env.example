# URL pública do projeto (usada em SEO, sitemap e robots.txt)
NEXT_PUBLIC_SITE_URL=https://seudominio.com

# Supabase — painel: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase endpoints (deixe em branco para usar os defaults do SDK em produção)
NEXT_PUBLIC_SUPABASE_REST_URL=
NEXT_PUBLIC_SUPABASE_GRAPHQL_URL=
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=
NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# Supabase Storage S3 (painel: Project Settings > Storage)
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=

# OAuth Google — console.cloud.google.com > Credenciais
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Banco de dados direto (migrações / scripts server-side)
DATABASE_URL=postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
